{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node", "dom-navigation", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "mdx/**/*.ts",
    "test/**/*",
    ".sprinkles/content-layer/**/*",
    "*.ts"
  ],
  "exclude": ["dist"]
}

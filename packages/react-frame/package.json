{
  "name": "react-frame",
  "version": "0.0.10",
  "description": "React routing with frames, rendered on a server with RSC or in a single-page app.",
  "homepage": "https://github.com/markmals/react-frame#readme",
  "bugs": {
    "url": "https://github.com/markmals/react-frame/issues"
  },
  "license": "MIT",
  "author": "Jacob Ebey <jacob.ebey@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmals/react-frame.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-server": "./dist/index.mjs",
      "default": "./dist/index.client.mjs"
    },
    "./browser": "./dist/browser.mjs",
    "./client": "./dist/client.mjs",
    "./spa": "./dist/spa.mjs",
    "./vite/browser": "./dist/vite/browser.mjs",
    "./vite/plugin": "./dist/vite/plugin.mjs",
    "./vite/server": "./dist/vite/server.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@ast-grep/napi": "catalog:",
    "rsc-html-stream": "catalog:"
  },
  "devDependencies": {
    "@types/dom-navigation": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "remix": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/plugin-rsc": "*",
    "react": "*",
    "react-dom": "*",
    "remix": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@vitejs/plugin-rsc": {
      "optional": true
    },
    "react-server-dom-webpack": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
